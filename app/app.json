{
  "expo": {
    "name": "Vazy",
    "slug": "my-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F8FF"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Medel/Medel.ttf"
          ],
          "android": {
            "fontFamily": "Poppins",
            "fonDefinitions": [
              {
                "path": "./assets/fonts/Poppins/Poppins-Regular.ttf",
                "weight": 400
              },
              {
                "path": "./assets/fonts/Poppins/Poppins-Medium.ttf",
                "weight": 500
              },
              {
                "path": "./assets/fonts/Poppins/Poppins-SemiBold.ttf",
                "weight": 600
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Poppins/Poppins-Regular.ttf",
              "./assets/fonts/Poppins/Poppins-Medium.ttf",
              "./assets/fonts/Poppins/Poppins-SemiBold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
{
  "name": "vazy-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "check": "node src/dispatch.check.ts",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --project demo-vazy --only firestore \"node --test firestore.rules.test.ts\"",
    "test:smoke": "firebase emulators:exec --project demo-vazy --only firestore \"node smoke.check.ts\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.18.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.36.0",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1"
  }
}
